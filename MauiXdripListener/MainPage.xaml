<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiXdripListener.MainPage"
             BackgroundColor="#1D1B27"
             Padding="24">
    <VerticalStackLayout Spacing="12">
        <Label Text="xDrip Broadcast Viewer" FontSize="28" FontAttributes="Bold" />
        <Label x:Name="StatusLabel" Text="Waiting for data..." FontSize="14" />
        <Frame BackgroundColor="#2C2A3A" Padding="16" CornerRadius="12">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="ValueLabel" Text="Glucose: --" FontSize="22" />
                <Label x:Name="SlopeLabel" Text="Slope: --" FontSize="14" />
                <Label x:Name="SourceLabel" Text="Source: --" FontSize="14" />
                <Label x:Name="TimestampLabel" Text="Time: --" FontSize="14" />
            </VerticalStackLayout>
        </Frame>
        <Label x:Name="RawLabel" Text="Raw extras will appear here when available." FontSize="12" LineBreakMode="WordWrap" />
    </VerticalStackLayout>
</ContentPage>
