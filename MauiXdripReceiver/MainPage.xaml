<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiXdripReceiver.MainPage">
    <VerticalStackLayout
        Spacing="16"
        Padding="24"
        VerticalOptions="Center">
        <Label Text="xDrip Broadcast Receiver"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               FontSize="24" />
        <Label Text="The app registers an Android broadcast receiver for xDrip messages."
               HorizontalTextAlignment="Center" />
        <Label Text="Broadcasts are logged to Logcat even when the app is closed."
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
